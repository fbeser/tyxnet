# Keep repository text deterministic across Windows, macOS, and Linux.
* text=auto eol=lf

# Windows-only scripts use native Windows line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never apply text conversion to binary artifacts.
*.dll binary
*.exe binary
*.icns binary
*.ico binary
*.jpg binary
*.png binary
*.woff binary
*.woff2 binary
