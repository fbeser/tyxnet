# Set one public address for HTTPS, or leave both empty for LAN-only HTTP.
TYXNET_PUBLIC_IP=203.0.113.10
TYXNET_DOMAIN=

# Use latest for automatic updates or pin a release such as 0.3.12.
TYXNET_VERSION=latest

# Host ports. The TyxNet container continues to listen on 8443/TCP and 51830/UDP.
TYXNET_LAN_PORT=8443
TYXNET_TUNNEL_PORT=51830
TYXNET_HTTP_CHALLENGE_PORT=18080
TYXNET_HTTPS_PORT=18443

# Stable resource names preserve data when CasaOS changes the Compose project name.
TYXNET_DATA_VOLUME=tyxnet_tyxnet-data
TYXNET_CADDY_DATA_VOLUME=tyxnet_caddy-data
TYXNET_CADDY_CONFIG_VOLUME=tyxnet_caddy-config
