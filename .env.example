# Set exactly one public address. A domain takes precedence when both are set.
TYXNET_PUBLIC_IP=203.0.113.10
TYXNET_DOMAIN=

# Use latest for automatic updates or pin a release such as 0.3.2.
TYXNET_VERSION=latest

# Host ports. The TyxNet container continues to listen on 8443/TCP and 51830/UDP.
TYXNET_LAN_PORT=8443
TYXNET_TUNNEL_PORT=51830
TYXNET_HTTP_CHALLENGE_PORT=18080
TYXNET_HTTPS_PORT=18443
